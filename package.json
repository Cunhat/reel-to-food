{
  "name": "reel-to-food",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@cloudflare/workers-types": "^5.20260728.1",
      "better-auth": "1.6.25",
      "alchemy": "^0.93.12",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "@tanstack/react-form": "^1.33.2",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.6.25"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:generate": "turbo run db:generate -F @reel-to-food/db",
    "db:push": "turbo run db:push -F @reel-to-food/db",
    "deploy": "turbo run deploy -F @reel-to-food/infra",
    "destroy": "turbo run destroy -F @reel-to-food/infra",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@reel-to-food/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@reel-to-food/config": "workspace:*",
    "@types/node": "^22.20.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.1"
}
